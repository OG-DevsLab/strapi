# =============================================================#
# Strapi Environment Variables - Development Configuration
# =============================================================#

# Node Environment
NODE_ENV=development

# Strapi Core Configuration
HOST=0.0.0.0
PORT=1337

# Public URLs (for development)
URL=http://localhost:1337
PUBLIC_URL=http://localhost:1337
BROWSER_URL=http://localhost:1337
SERVER_URL=http://localhost:1337
ADMIN_URL=http://localhost:1337/admin

# Strapi Admin Configuration
STRAPI_ADMIN_BACKEND_URL=http://localhost:1337
STRAPI_ADMIN_CLIENT_URL=http://localhost:1337
STRAPI_ADMIN_CLIENT_PREVIEW_SECRET=preview-secret-key
ADMIN_PATH=/admin

# Security Keys (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=defaultJwtSecret123456789
APP_KEYS=defaultAppKey1,defaultAppKey2,defaultAppKey3,defaultAppKey4
API_TOKEN_SALT=defaultApiTokenSalt123
ADMIN_JWT_SECRET=defaultAdminJwtSecret123
TRANSFER_TOKEN_SALT=defaultTransferTokenSalt123

# Database Configuration
DB=postgres
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi

# Optional: MySQL Database (alternative to PostgreSQL)
# DATABASE_CLIENT=mysql
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi

# Strapi Behavior Settings
STRAPI_DISABLE_UPDATE_NOTIFICATION=true
STRAPI_HIDE_STARTUP_MESSAGE=true
STRAPI_LOG_LEVEL=info

# Network Configuration
IS_PROXIED=false
ALLOWED_HOST=localhost

# =============================================================#
# Development Notes:
# - These are development values, DO NOT use in production
# - Change all secrets and keys before deploying
# - Database credentials match docker-compose.dev.yml
# =============================================================#